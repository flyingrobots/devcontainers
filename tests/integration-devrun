#!/usr/bin/env bash
# Real-Docker integration test for bin/devrun. Needs flyingrobots/rust-dev:1.96.0 (scripts/build-image 1.96.0).
# Uses a throwaway project name (devrun-selftest-<random>), so it never meets another run's resources,
# and at the end removes only containers and volumes labelled with that project.
# The sections about concurrency use a private devrun state directory, so that they control the
# slots themselves; their containers are small (1 CPU, 1 GiB). The other sections use the shared
# state directory and count against the machine's run cap like any other run.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
devrun="$root/bin/devrun"
project="devrun-selftest-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
owner="label=org.flyingrobots.owner=$project"
fail() { echo "integration-devrun: FAIL: $*" >&2; exit 1; }
work="$(mktemp -d -t devrun-selftest-XXXXXX)"
private="$work/state"
small=(--cpus 1 --memory 1g --timeout 300)
pids=()  # background devrun processes started by this script
foreign_decoy=0  # 1 while the decoy volume with another owner label, created by this script, exists
cleanup() {
  local status=$? pid
  for pid in ${pids[@]+"${pids[@]}"}; do kill -TERM "$pid" 2>/dev/null || true; done
  for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid" 2>/dev/null || true; done
  # Every resource with this owner label was created by this script or by the runs it started.
  docker ps -aq --filter "$owner" | while read -r id; do docker rm -f "$id" >/dev/null || true; done
  docker volume ls -q --filter "$owner" | while read -r v; do docker volume rm "$v" >/dev/null || true; done
  if [[ "$foreign_decoy" == 1 ]]; then docker volume rm "$project-work-000000000000" >/dev/null 2>&1 || true; fi
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT

# prun: devrun with the private state directory, coordinated even in CI (CI=true turns slots off).
# spawn: the same, for `spawn ... &`: exec makes $! the pid of devrun itself, so signals reach it.
prun() { env -u CI DEVRUN_STATE_DIR="$private" "$devrun" "$@"; }
spawn() { exec env -u CI DEVRUN_STATE_DIR="$private" "$devrun" "$@"; }
now() { python3 -c 'import time; print(f"{time.time():.3f}")'; }
elapsed() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", b - a }'; }
before() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 <= b + 0) }'; }
field() { sed -n "s/^$1 //p" "$2" | head -1; }
run_id_of() { sed -n 's/^devrun: run \([0-9a-f]*\),.*/\1/p' "$1" | head -1; }
# wait_for SECONDS WHAT COMMAND...: poll COMMAND until it succeeds, failing after SECONDS.
wait_for() {
  local limit=$1 what=$2; shift 2
  local end=$((SECONDS + limit))
  until "$@"; do
    (( SECONDS < end )) || fail "timed out after ${limit}s waiting for $what"
    sleep 0.2
  done
}
has_line() { grep -q "$1" "$2" 2>/dev/null; }
leftovers_of() {  # resources of one run that still exist
  docker ps -aq --filter "$owner" --filter "label=org.flyingrobots.run-id=$1"
  docker volume ls -q --filter "$owner" --filter "label=org.flyingrobots.run-id=$1"
}
no_run_leftovers() {  # no container and no per-run volume of this project is left
  [[ -z "$(docker ps -aq --filter "$owner")" ]] || fail "a container is left: $(docker ps -a --filter "$owner" --format '{{.Names}}')"
  [[ -z "$(docker volume ls -q --filter "$owner" --filter label=org.flyingrobots.run-id)" ]] ||
    fail "a per-run volume is left: $(docker volume ls -q --filter "$owner" --filter label=org.flyingrobots.run-id)"
}
# The timed command: prints its start and end time from inside the container, and its marker file.
# shellcheck disable=SC2016  # $(date ...) and $1 must expand inside the container.
timed='echo "start $(date +%s.%N)"; cat marker.txt; sleep "$1"; echo "end $(date +%s.%N)"'

repo="$work/repo"; mkdir -p "$repo/src"
git -C "$repo" init -q -b main
printf 'hello\n' > "$repo/README"
printf 'fn main() {}\n' > "$repo/src/main.rs"
ln -s README "$repo/README.link"
git -C "$repo" add -A
git -C "$repo" -c user.name=t -c user.email=t@invalid commit -q -m "base: first"
base="$(git -C "$repo" rev-parse HEAD)"
printf 'second\n' >> "$repo/README"
git -C "$repo" -c user.name=t -c user.email=t@invalid commit -qam "feat: second

Repo-Respect-Receipt: none"
head="$(git -C "$repo" rev-parse HEAD)"

echo "== commit mode: isolation checks"
# shellcheck disable=SC2016  # the probe's $(...) and $HOME must expand inside the container, not on the host.
probe='set -e
test "$(id -u)" = 10001
test "$(pwd)" = /work
test -d "$HOME" && touch "$HOME/probe"
test "$TMPDIR" = /exec-tmp
printf "#!/bin/sh\necho ran\n" > "$TMPDIR/exe"
chmod +x "$TMPDIR/exe"
test "$("$TMPDIR/exe")" = ran
if touch /devrun-probe 2>/dev/null; then echo "the parent of /work is writable" >&2; exit 18; fi
test -f README && test -L README.link && test "$(cat README.link | head -1)" = hello
test -d .git  # created inside the container by devrun, empty baseline only
test "$(git log --format=%s)" = "devrun baseline"
if touch /usr/local/devrun-probe 2>/dev/null; then echo "root fs is writable" >&2; exit 11; fi
if curl -sS -m 5 https://example.com >/dev/null 2>&1; then echo "network reachable" >&2; exit 12; fi
if test -e /var/run/docker.sock; then echo "docker socket visible" >&2; exit 13; fi
grep -q "^CapEff:\s*0000000000000000" /proc/self/status || { echo "capabilities not dropped" >&2; exit 14; }
grep -q "^NoNewPrivs:\s*1" /proc/self/status || { echo "no_new_privs not set" >&2; exit 15; }
if touch /usr/local/cargo/registry/devrun-probe 2>/dev/null; then echo "cargo registry writable in the run phase" >&2; exit 16; fi
if touch /usr/local/cargo/config.toml 2>/dev/null; then echo "CARGO_HOME writable" >&2; exit 17; fi
echo ok > /scratch/out/result.txt
printf "changed\n" >> README'
out1="$work/out1"
"$devrun" "$project" "$repo" --commit "$head" --timeout 300 --export result.txt --export-patch --out "$out1" -- bash -c "$probe"
[[ "$(cat "$out1/result.txt")" == "ok" ]] || fail "export result.txt"
grep -q '^+changed$' "$out1/changes.patch" || fail "patch does not contain the change"
no_run_leftovers

echo "== worktree mode: untracked file included, ignored file excluded"
printf 'new\n' > "$repo/untracked.txt"
printf 'secret\n' > "$repo/ignored.env"; printf 'ignored.env\n' > "$repo/.gitignore"
out2="$work/out2"
"$devrun" "$project" "$repo" --worktree --timeout 300 --export result.txt --out "$out2" -- \
  bash -c 'test -f untracked.txt && ! test -e ignored.env && echo ok > /scratch/out/result.txt'
[[ "$(cat "$out2/result.txt")" == "ok" ]] || fail "worktree mode"

echo "== history mode: real commits, exact HEAD, origin/main at base"
out3="$work/out3"
"$devrun" "$project" "$repo" --history "$base..$head" --timeout 300 --export result.txt --out "$out3" -- \
  bash -c "test \"\$(git rev-parse HEAD)\" = $head && test \"\$(git rev-parse origin/main)\" = $base && git log -1 --format=%B | grep -q 'Repo-Respect-Receipt: none' && echo ok > /scratch/out/result.txt"
[[ "$(cat "$out3/result.txt")" == "ok" ]] || fail "history mode"

echo "== the iteration target is keyed by the worktree path and labelled with it"
real_repo="$(cd "$repo" && pwd -P)"
target_name="$(docker volume ls -q --filter "$owner" --filter label=org.flyingrobots.role=target)"
[[ "$(wc -l <<<"$target_name" | tr -d ' ')" == 1 ]] || fail "expected one target volume, found: $target_name"
[[ "$(docker volume inspect "$target_name" --format '{{index .Labels "org.flyingrobots.source-path"}}')" == "$real_repo" ]] ||
  fail "the target volume does not record the worktree path"

echo "== fetch phase: a planted cargo config runs no code while the caches are writable"
crate="$work/crate"; mkdir -p "$crate/src" "$crate/.cargo"
printf '[package]\nname = "selftest"\nversion = "0.1.0"\nedition = "2021"\n' > "$crate/Cargo.toml"
printf 'version = 4\n\n[[package]]\nname = "selftest"\nversion = "0.1.0"\n' > "$crate/Cargo.lock"
printf 'fn main() {}\n' > "$crate/src/main.rs"
printf '#!/bin/sh\ntouch /usr/local/cargo/registry/devrun-pwned 2>/dev/null\ntouch /tmp/devrun-wrapper-ran\nexec "$@"\n' > "$crate/evil-wrapper"; chmod 755 "$crate/evil-wrapper"
printf '[build]\nrustc-wrapper = "/work/evil-wrapper"\n' > "$crate/.cargo/config.toml"
printf '[toolchain]\npath = "/work/evil-toolchain"\n' > "$crate/rust-toolchain.toml"
git -C "$crate" init -q -b main && git -C "$crate" add -A && git -C "$crate" -c user.name=t -c user.email=t@invalid commit -qm fetch
out4="$work/out4"
# Two layers protect this phase: the fetch copy drops the config and toolchain files, and the
# environment overrides them. Disabling both makes cargo honour the planted toolchain and fail here.
if ! "$devrun" "$project" "$crate" --commit HEAD --fetch --timeout 300 --export result.txt --out "$out4" -- \
  bash -c 'test ! -e /usr/local/cargo/registry/devrun-pwned && test -f .cargo/config.toml && test -f rust-toolchain.toml &&
    # Control: with the config present, cargo fetch does call the wrapper, so the check above is not vacuous.
    { RUSTUP_TOOLCHAIN=1.96.0 cargo fetch --locked >/dev/null 2>&1 || true; } && test -e /tmp/devrun-wrapper-ran &&
    echo ok > /scratch/out/result.txt'; then
  fail "the fetch phase honoured the planted cargo config or toolchain"
fi
[[ "$(cat "$out4/result.txt")" == "ok" ]] || fail "fetch phase ran the planted wrapper, or phase 2 lost the config files"

echo "== commit mode after a newer build: an older commit date does not reuse stale output (issue #9)"
bin="$work/bin"; mkdir -p "$bin/src"
printf '[package]\nname = "stale"\nversion = "0.1.0"\nedition = "2021"\n' > "$bin/Cargo.toml"
printf 'version = 4\n\n[[package]]\nname = "stale"\nversion = "0.1.0"\n' > "$bin/Cargo.lock"
printf 'fn main() { println!("built-from-A"); }\n' > "$bin/src/main.rs"
git -C "$bin" init -q -b main && git -C "$bin" add -A && git -C "$bin" -c user.name=t -c user.email=t@invalid commit -qm A
commit_a="$(git -C "$bin" rev-parse HEAD)"
printf 'fn main() { println!("built-from-B"); }\n' > "$bin/src/main.rs"
# B's commit date is years older than the build of A, so git archive gives B's files old times.
GIT_COMMITTER_DATE="2001-01-01T00:00:00Z" GIT_AUTHOR_DATE="2001-01-01T00:00:00Z" \
  git -C "$bin" -c user.name=t -c user.email=t@invalid commit -qam B
commit_b="$(git -C "$bin" rev-parse HEAD)"
[[ "$("$devrun" "$project" "$bin" --commit "$commit_a" "${small[@]}" -- cargo run -q --locked 2>/dev/null)" == built-from-A ]] || fail "commit A did not build"
got="$("$devrun" "$project" "$bin" --commit "$commit_b" "${small[@]}" -- cargo run -q --locked 2>/dev/null)"
[[ "$got" == built-from-B ]] || fail "commit B ran the stale build of commit A: $got"

echo "== two --commit runs of one worktree at once: the second never reuses the first one's build (issue #12, 1)"
# A refreshes its copy, then waits until B has refreshed its own copy too, then builds. B waits for A's
# build, then builds. Without the pinned-target lock B's copy predates A's build, and cargo reuses A's
# binary. With the lock B cannot start until A has finished, so A's wait for B ends at its bound.
pin="$work/pin"; mkdir -p "$pin/src"
printf '[package]\nname = "pin"\nversion = "0.1.0"\nedition = "2021"\n' > "$pin/Cargo.toml"
printf 'version = 4\n\n[[package]]\nname = "pin"\nversion = "0.1.0"\n' > "$pin/Cargo.lock"
printf 'fn main() { println!("built-from-P1"); }\n' > "$pin/src/main.rs"
git -C "$pin" init -q -b main && git -C "$pin" add -A && git -C "$pin" -c user.name=t -c user.email=t@invalid commit -qm P1
commit_p1="$(git -C "$pin" rev-parse HEAD)"
printf 'fn main() { println!("built-from-P2"); }\n' > "$pin/src/main.rs"
git -C "$pin" -c user.name=t -c user.email=t@invalid commit -qam P2
commit_p2="$(git -C "$pin" rev-parse HEAD)"
# await FILE TENTHS: wait inside the container until FILE exists in the shared target, at most TENTHS/10 s.
# shellcheck disable=SC2016  # expands inside the container.
await='await() { i=0; while [ ! -e "$1" ] && [ "$i" -lt "$2" ]; do sleep 0.1; i=$((i + 1)); done; }'
# shellcheck disable=SC2016
pin_a="$await"'; echo "start $(date +%s.%N)"; await /target/sync-b 150; echo "build $(date +%s.%N)"; cargo run -q --locked; touch /target/sync-a; echo "end $(date +%s.%N)"'
# shellcheck disable=SC2016
pin_b="$await"'; echo "start $(date +%s.%N)"; touch /target/sync-b; await /target/sync-a 600; cargo run -q --locked'
spawn "$project" "$pin" --commit "$commit_p1" "${small[@]}" -- bash -c "$pin_a" >"$work/pa.out" 2>"$work/pa.err" & p1=$!
pids=("$p1")
wait_for 120 "commit run A's command to start" has_line '^start ' "$work/pa.out"
spawn "$project" "$pin" --commit "$commit_p2" "${small[@]}" -- bash -c "$pin_b" >"$work/pb.out" 2>"$work/pb.err" & p2=$!
pids+=("$p2")
wait "$p1" || fail "commit run A failed: $(cat "$work/pa.err")"
wait "$p2" || fail "commit run B failed: $(cat "$work/pb.err")"
pids=()
grep -qx built-from-P1 "$work/pa.out" || fail "commit run A did not run its own build: $(cat "$work/pa.out")"
grep -qx built-from-P2 "$work/pb.out" || fail "commit run B ran another commit's build: $(grep built-from "$work/pb.out")"
grep -q 'waiting for the pinned build target of this worktree' "$work/pb.err" || fail "commit run B did not wait for run A"
before "$(field end "$work/pa.out")" "$(field start "$work/pb.out")" || fail "two pinned runs of one worktree overlapped"

echo "== a --worktree run during a --commit run of the same worktree: the commit run builds its own source"
# C refreshes its copy, waits for W's build, then builds; W builds once C has refreshed. In one shared
# target C would reuse W's build. Pinned runs have their own target, so neither sees the other's marker
# files and both waits end at their bound.
printf 'fn main() { println!("built-from-W"); }\n' > "$pin/src/main.rs"
# shellcheck disable=SC2016
pin_c="$await"'; echo "start $(date +%s.%N)"; touch /target/sync-c; await /target/sync-w 150; cargo run -q --locked'
# shellcheck disable=SC2016
pin_w="$await"'; await /target/sync-c 150; cargo run -q --locked; touch /target/sync-w'
spawn "$project" "$pin" --commit "$commit_p2" "${small[@]}" -- bash -c "$pin_c" >"$work/pc.out" 2>"$work/pc.err" & p1=$!
spawn "$project" "$pin" --worktree "${small[@]}" -- bash -c "$pin_w" >"$work/pw.out" 2>"$work/pw.err" & p2=$!
pids=("$p1" "$p2")
wait "$p1" || fail "commit run C failed: $(cat "$work/pc.err")"
wait "$p2" || fail "worktree run W failed: $(cat "$work/pw.err")"
pids=()
grep -qx built-from-P2 "$work/pc.out" || fail "commit run C ran the worktree's build: $(grep built-from "$work/pc.out")"
grep -qx built-from-W "$work/pw.out" || fail "worktree run W did not run its own build: $(cat "$work/pw.out")"

echo "== a --worktree run after a --commit run sees an edit made before the commit run (issue #9, case 1)"
printf 'fn main() { println!("built-from-E"); }\n' > "$pin/src/main.rs"
[[ "$(prun "$project" "$pin" --commit "$commit_p2" "${small[@]}" -- cargo run -q --locked 2>/dev/null)" == built-from-P2 ]] ||
  fail "the commit run did not build its commit"
got="$(prun "$project" "$pin" --worktree "${small[@]}" -- cargo run -q --locked 2>/dev/null)"
[[ "$got" == built-from-E ]] || fail "the worktree run reused the commit run's build: $got"
no_run_leftovers

echo "== two runs of the same project at once, from two worktrees of one repository"
git -C "$repo" add -A && git -C "$repo" -c user.name=t -c user.email=t@invalid commit -qm "worktree base"
git -C "$repo" worktree add -q "$work/wt2"
printf 'marker-one\n' > "$repo/marker.txt"
printf 'marker-two\n' > "$work/wt2/marker.txt"
t0="$(now)"
spawn "$project" "$repo" --worktree "${small[@]}" -- bash -c "$timed" timed 5 >"$work/c1.out" 2>"$work/c1.err" & p1=$!
spawn "$project" "$work/wt2" --worktree "${small[@]}" -- bash -c "$timed" timed 5 >"$work/c2.out" 2>"$work/c2.err" & p2=$!
pids=("$p1" "$p2")
wait "$p1" || fail "concurrent run 1 failed: $(cat "$work/c1.err")"
wait "$p2" || fail "concurrent run 2 failed: $(cat "$work/c2.err")"
pids=()
t1="$(now)"
if ! grep -qx marker-one "$work/c1.out" || grep -q marker-two "$work/c1.out"; then fail "run 1 did not see only its own source"; fi
if ! grep -qx marker-two "$work/c2.out" || grep -q marker-one "$work/c2.out"; then fail "run 2 did not see only its own source"; fi
if ! before "$(field start "$work/c2.out")" "$(field end "$work/c1.out")" || ! before "$(field start "$work/c1.out")" "$(field end "$work/c2.out")"; then
  fail "the two runs did not overlap"
fi
[[ "$(run_id_of "$work/c1.err")" != "$(run_id_of "$work/c2.err")" ]] || fail "the runs share a run id"
no_run_leftovers
t2="$(now)"
prun "$project" "$repo" --worktree "${small[@]}" -- bash -c "$timed" timed 5 >/dev/null 2>"$work/s1.err" || fail "sequential run 1: $(cat "$work/s1.err")"
prun "$project" "$work/wt2" --worktree "${small[@]}" -- bash -c "$timed" timed 5 >/dev/null 2>"$work/s2.err" || fail "sequential run 2: $(cat "$work/s2.err")"
t3="$(now)"
echo "integration-devrun: two same-project runs (5 s commands): together $(elapsed "$t0" "$t1") s, back to back $(elapsed "$t2" "$t3") s"

echo "== the cap: with --max-runs 1, two runs take turns"
spawn "$project" "$repo" --worktree "${small[@]}" --max-runs 1 -- bash -c "$timed" timed 3 >"$work/m1.out" 2>"$work/m1.err" & p1=$!
spawn "$project" "$work/wt2" --worktree "${small[@]}" --max-runs 1 -- bash -c "$timed" timed 3 >"$work/m2.out" 2>"$work/m2.err" & p2=$!
pids=("$p1" "$p2")
wait "$p1" || fail "capped run 1 failed: $(cat "$work/m1.err")"
wait "$p2" || fail "capped run 2 failed: $(cat "$work/m2.err")"
pids=()
if before "$(field start "$work/m1.out")" "$(field start "$work/m2.out")"; then first=m1 second=m2; else first=m2 second=m1; fi
before "$(field end "$work/$first.out")" "$(field start "$work/$second.out")" || fail "two runs overlapped under --max-runs 1"
grep -q 'waiting for a run slot' "$work/$second.err" || fail "the second run did not report that it was waiting"

echo "== an exclusive run does not overlap ordinary runs, and is not starved by later ones"
spawn "$project" "$repo" --worktree "${small[@]}" -- bash -c "$timed" timed 6 >"$work/a.out" 2>"$work/a.err" & pa=$!
pids=("$pa")
wait_for 120 "the ordinary run's command to start" has_line '^start ' "$work/a.out"
spawn "$project" "$repo" --worktree "${small[@]}" --exclusive -- bash -c "$timed" timed 2 >"$work/e.out" 2>"$work/e.err" & pe=$!
pids+=("$pe")
wait_for 120 "the exclusive run to queue" has_line 'waiting for exclusive access' "$work/e.err"
spawn "$project" "$work/wt2" --worktree "${small[@]}" -- bash -c "$timed" timed 1 >"$work/b.out" 2>"$work/b.err" & pb=$!
pids+=("$pb")
wait "$pa" || fail "ordinary run A failed: $(cat "$work/a.err")"
wait "$pe" || fail "exclusive run failed: $(cat "$work/e.err")"
wait "$pb" || fail "ordinary run B failed: $(cat "$work/b.err")"
pids=()
before "$(field end "$work/a.out")" "$(field start "$work/e.out")" || fail "the exclusive run started before ordinary run A ended"
before "$(field end "$work/e.out")" "$(field start "$work/b.out")" || fail "ordinary run B, started after the exclusive run queued, ran before it ended"

echo "== SIGTERM: the run removes its container and volumes"
spawn "$project" "$repo" --worktree "${small[@]}" -- bash -c "$timed" timed 120 >"$work/t.out" 2>"$work/t.err" & pt=$!
pids=("$pt")
wait_for 120 "the run's command to start" has_line '^start ' "$work/t.out"
rid="$(run_id_of "$work/t.err")"
[[ -n "$(leftovers_of "$rid")" ]] || fail "the run's resources were not found while it ran"
kill -TERM "$pt"
if wait "$pt"; then fail "a run killed with SIGTERM exited 0"; fi
pids=()
grep -q 'interrupted by signal' "$work/t.err" || fail "the run did not report the signal: $(cat "$work/t.err")"
[[ -z "$(leftovers_of "$rid")" ]] || fail "SIGTERM left resources of run $rid: $(leftovers_of "$rid")"

echo "== SIGKILL: --gc keeps a dead run's running container, then removes everything once it stopped"
spawn "$project" "$repo" --worktree "${small[@]}" -- bash -c "$timed" timed 10 >"$work/k.out" 2>"$work/k.err" & pk=$!
pids=("$pk")
wait_for 120 "the run's command to start" has_line '^start ' "$work/k.out"
rid="$(run_id_of "$work/k.err")"
kill -KILL "$pk"
wait "$pk" 2>/dev/null || true
pids=()
env DEVRUN_STATE_DIR="$private" "$devrun" --gc "$project" >"$work/gc1.out" || fail "gc failed: $(cat "$work/gc1.out")"
grep -q "keep $project-dev-run-$rid: run $rid is dead but its container is still running" "$work/gc1.out" ||
  fail "gc did not keep the running container: $(cat "$work/gc1.out")"
[[ -n "$(docker ps -q --filter "label=org.flyingrobots.run-id=$rid")" ]] || fail "gc touched a running container"
stopped() { [[ -z "$(docker ps -q --filter "$owner" --filter "label=org.flyingrobots.run-id=$rid")" ]]; }
wait_for 60 "the orphaned container to exit" stopped
env DEVRUN_STATE_DIR="$private" "$devrun" --gc "$project" >"$work/gc2.out" || fail "gc failed: $(cat "$work/gc2.out")"
[[ -z "$(leftovers_of "$rid")" ]] || fail "gc left resources of dead run $rid: $(leftovers_of "$rid")"
[[ ! -e "$private/runs/$rid.lock" ]] || fail "gc did not forget the dead run"

# epoch NAME FIELD: a container's State.StartedAt or State.FinishedAt, in seconds, by the daemon's clock.
epoch() {
  python3 -c 'import datetime, re, sys
m = re.fullmatch(r"(\S+?)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)", sys.argv[1])
zone = "+00:00" if m.group(3) == "Z" else m.group(3)
print("%.3f" % (datetime.datetime.fromisoformat(m.group(1) + zone).timestamp() + float("0." + (m.group(2) or "0"))))' \
    "$(docker inspect -f "{{.State.$2}}" "$1")"
}
running() { [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == true ]]; }
not_running() { ! running "$1"; }
# finished NAME: when the container stopped. Docker reports year 1 for a running container, so wait.
finished() {
  wait_for 300 "container $1 to stop" not_running "$1"
  local t; t="$(epoch "$1" FinishedAt)"
  before 1000000000 "$t" || fail "container $1 has no finish time: $t"
  echo "$t"
}
waits_or_starts() { has_line "$1" "$2" || has_line '^start ' "$3"; }

echo "== SIGKILL: the surviving container keeps its slot, and an exclusive run waits until it ends (issue #12, 2)"
spawn "$project" "$repo" --worktree "${small[@]}" --max-runs 1 -- bash -c "$timed" timed 20 >"$work/s.out" 2>"$work/s.err" & ps_=$!
pids=("$ps_")
wait_for 120 "the run's command to start" has_line '^start ' "$work/s.out"
srid="$(run_id_of "$work/s.err")"; survivor="$project-dev-run-$srid"
kill -KILL "$ps_"
wait "$ps_" 2>/dev/null || true
running "$survivor" || fail "the container did not survive its runner"
spawn "$project" "$work/wt2" --worktree "${small[@]}" --max-runs 1 -- bash -c "$timed" timed 1 >"$work/o.out" 2>"$work/o.err" & po=$!
pids=("$po")
wait_for 120 "the ordinary run to wait or start" waits_or_starts "runner of $survivor is dead" "$work/o.err" "$work/o.out"
if has_line '^start ' "$work/o.out" && running "$survivor"; then fail "an ordinary run started beside the survivor under --max-runs 1"; fi
spawn "$project" "$repo" --worktree "${small[@]}" --exclusive -- bash -c "$timed" timed 1 >"$work/x.out" 2>"$work/x.err" & px=$!
pids+=("$px")
wait_for 120 "the exclusive run to wait or start" waits_or_starts "exclusive access (the runner of $survivor is dead" "$work/x.err" "$work/x.out"
wait "$po" || fail "the ordinary run failed: $(cat "$work/o.err")"
wait "$px" || fail "the exclusive run failed: $(cat "$work/x.err")"
pids=()
survivor_end="$(finished "$survivor")"
before "$survivor_end" "$(field start "$work/o.out")" || fail "the ordinary run started before the survivor ended"
before "$survivor_end" "$(field start "$work/x.out")" || fail "the exclusive run started before the survivor ended"

echo "== a survivor past its own timeout is stopped by the run that waits for it, and by nothing earlier"
spawn "$project" "$repo" --worktree "${small[@]}" --timeout 12 -- bash -c "$timed" timed 300 >"$work/v.out" 2>"$work/v.err" & pv=$!
pids=("$pv")
wait_for 120 "the run's command to start" has_line '^start ' "$work/v.out"
vrid="$(run_id_of "$work/v.err")"; overdue="$project-dev-run-$vrid"
kill -KILL "$pv"
wait "$pv" 2>/dev/null || true
pids=()
prun "$project" "$work/wt2" --worktree "${small[@]}" --exclusive -- bash -c "$timed" timed 1 >"$work/y.out" 2>"$work/y.err" ||
  fail "the exclusive run failed: $(cat "$work/y.err")"
grep -q "stopping $overdue: its runner is dead and its 12 s timeout has passed" "$work/y.err" ||
  fail "the exclusive run did not stop the overdue survivor: $(cat "$work/y.err")"
running "$overdue" && fail "the overdue survivor is still running"
overdue_end="$(finished "$overdue")"
lived="$(awk -v a="$(epoch "$overdue" StartedAt)" -v b="$overdue_end" 'BEGIN { printf "%.1f", b - a }')"
before 12 "$lived" || fail "the survivor was stopped after $lived s, before its 12 s timeout"
before 60 "$lived" && fail "the survivor lived $lived s: nothing stopped it at its 12 s timeout"
before "$overdue_end" "$(field start "$work/y.out")" || fail "the exclusive run started before the survivor stopped"
env DEVRUN_STATE_DIR="$private" "$devrun" --gc "$project" >"$work/gc4.out" || fail "gc failed: $(cat "$work/gc4.out")"
for r in "$srid" "$vrid"; do
  [[ -z "$(leftovers_of "$r")" ]] || fail "gc left resources of dead run $r: $(leftovers_of "$r")"
done

echo "== --gc removes the target of a deleted worktree and never touches resources it cannot prove are leftovers"
gone="$work/gone"; mkdir -p "$gone"; git -C "$gone" init -q -b main; printf 'x\n' > "$gone/x"
prun "$project" "$gone" --worktree "${small[@]}" -- true 2>/dev/null || fail "run in the soon-deleted worktree"
gone_key="$(python3 -c 'import hashlib, os, sys; print(hashlib.sha256(os.fsencode(os.path.realpath(sys.argv[1]))).hexdigest()[:16])' "$gone")"
gone_target="$project-target-$gone_key"
docker volume inspect "$gone_target" >/dev/null || fail "no target volume $gone_target"
rm -rf "$gone"
docker volume create --label "org.flyingrobots.owner=$project" --label org.flyingrobots.role=work "$project-work" >/dev/null
foreign_decoy=1
docker volume create --label org.flyingrobots.owner=someone-else --label org.flyingrobots.role=work \
  --label org.flyingrobots.run-id=000000000000 "$project-work-000000000000" >/dev/null
docker create --name "$project-dev-run" --label "org.flyingrobots.owner=$project" --label org.flyingrobots.role=dev-run \
  flyingrobots/rust-dev:1.96.0 true >/dev/null
env DEVRUN_STATE_DIR="$private" "$devrun" --gc "$project" >"$work/gc3.out" || fail "gc failed: $(cat "$work/gc3.out")"
grep -qx "devrun gc: remove volume $gone_target" "$work/gc3.out" || fail "gc did not remove the deleted worktree's target: $(cat "$work/gc3.out")"
if docker volume inspect "$gone_target" >/dev/null 2>&1; then fail "the deleted worktree's target still exists"; fi
docker volume inspect "$target_name" >/dev/null || fail "gc removed the target of an existing worktree"
docker volume inspect "$project-work" >/dev/null || fail "gc removed a volume without a run id"
docker volume inspect "$project-work-000000000000" >/dev/null || fail "gc removed another owner's volume"
docker container inspect "$project-dev-run" >/dev/null || fail "gc removed a container without a run id"
docker rm "$project-dev-run" >/dev/null
docker volume rm "$project-work" "$project-work-000000000000" >/dev/null
foreign_decoy=0

echo "== refusals"
ln -s /etc/passwd "$repo/evil"; git -C "$repo" add evil; git -C "$repo" -c user.name=t -c user.email=t@invalid commit -qm "evil"
if "$devrun" "$project" "$repo" --commit HEAD --timeout 60 -- true 2>"$work/err"; then fail "absolute symlink accepted"; fi
grep -q 'absolute symlink' "$work/err" || fail "wrong refusal: $(cat "$work/err")"
no_run_leftovers

echo "integration-devrun: PASS"
